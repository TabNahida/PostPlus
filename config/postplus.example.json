  "delivery_lock_port": 18085,
  "ports": {
    "auth": 18081,
    "storage": 18082,
    "filter": 18083,
    "transfer": 18084,
    "smtp": 2525,
    "pop3": 1110,
    "imap": 1143,
    "web": 8080
