  "smarthost_host": "",
  "smarthost_port": 587,
  "smarthost_timeout_seconds": 30,
  "smarthost_tls": "starttls",
  "smarthost_username": "",
  "smarthost_password_env": "POSTPLUS_SMARTHOST_PASSWORD",
