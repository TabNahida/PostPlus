{
  "domain": "localhost",
  "bind": "127.0.0.1",
  "data_dir": "../data",
  "web_root": "../web",
  "service_token_env": "POSTPLUS_SERVICE_TOKEN",
  "service_token_file": "",
  "log_dir": "../data/logs",
  "log_level": "info",
  "log_max_bytes": 5242880,
  "log_backups": 3,
